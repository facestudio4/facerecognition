APP_ENV=production
APP_NAME=FaceRecognitionStudio
API_HOST=0.0.0.0
API_PORT=8787
SQLITE_PATH=/var/data/facestudio.db
# Store enrolled face images + encodings on the persistent disk so they survive
# redeploys/restarts (Render's filesystem is otherwise ephemeral).
FACES_ROOT=/var/data/faces
FACE_ENCODINGS_PATH=/var/data/face_encodings.pkl

# Durable persistence on the free tier (Render has no disk on free): the backend
# mirrors the SQLite DB, the encodings cache and face images to Supabase Storage,
# and restores them on startup. Without these, all runtime data (new users,
# logins, faces) is wiped on every redeploy/sleep. Create a free Supabase project,
# make a private Storage bucket named 'facestudio-data', then set:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service_role-key
SUPABASE_BUCKET=facestudio-data

FACE_STUDIO_MOBILE_LATEST_VERSION=0.1.0+52
FACE_STUDIO_MOBILE_MIN_VERSION=0.1.0+33
FACE_STUDIO_MOBILE_APK_URL=https://github.com/facestudio4/facerecognition/releases/download/v0.1.0%2B52/mobile_0.1.0%2B52.apk
FACE_STUDIO_MOBILE_UPDATE_NOTES=Face Studio v0.1.0+52 — full-screen ringing for incoming calls + a fresh, modern People/Chat design.

# Firebase Cloud Messaging: paste the whole service-account JSON as the value.
FACESTUDIO_FCM_SERVICE_ACCOUNT=

# JaaS (8x8) for sign-in-free calls. Set all three to use 8x8.vc; else meet.jit.si.
JAAS_APP_ID=
JAAS_KID=
JAAS_PRIVATE_KEY=

# Gallery-scan strictness — tune without rebuilding the app (higher = stricter).
MOBILE_GALLERY_AUTOSAVE=0.72
MOBILE_GALLERY_REVIEW=0.55
MOBILE_GALLERY_MARGIN=0.08
FACE_STUDIO_MOBILE_FORCE_UPDATE=false

MOBILE_RECOGNITION_THRESHOLD=0.48
MOBILE_RECOGNITION_MARGIN=0.03

# --- Security hardening (see CLAUDE.md) ---
# Keep the backend API key / token secret out of the committed DB. Set these to
# the CURRENT values to avoid breaking the app, or rotate (rotating the token
# secret logs everyone out; rotating the API key needs a matching app rebuild).
FACESTUDIO_API_KEY=
FACESTUDIO_TOKEN_SECRET=
# Browser CORS allowlist (comma-separated). Empty = locked down (mobile is fine).
FACESTUDIO_ALLOWED_ORIGINS=
# Leak error details to clients ONLY in local dev. Never set to 1 in production.
FACESTUDIO_DEBUG=false
# Optional rate-limit tuning (defaults shown).
FACESTUDIO_RL_AUTH_MAX=15
FACESTUDIO_RL_API_MAX=300

FACESTUDIO_SIGNUP_ALLOW_SMTP_FALLBACK=1

# IMPORTANT: Render blocks outbound SMTP (you'll see "Network is unreachable").
# Send verification emails over an HTTP API instead. Brevo is free (300/day) and
# needs no domain — just verify the sender (FACESTUDIO_SMTP_FROM) in Brevo, then
# create an API key and put it here. When set, this is used instead of SMTP.
FACESTUDIO_BREVO_API_KEY=your-brevo-api-key
FACESTUDIO_EMAIL_FROM_NAME=Face Studio

# SMTP is only a local-dev fallback (does not work on Render).
FACESTUDIO_SMTP_HOST=smtp.gmail.com
FACESTUDIO_SMTP_USER=your-email@gmail.com
FACESTUDIO_SMTP_APP_PASSWORD=your-app-password
FACESTUDIO_SMTP_FROM=your-email@gmail.com
FACESTUDIO_SMTP_PORT=587
FACESTUDIO_SMTP_TLS=1
FACESTUDIO_SMTP_SSL=0
FACESTUDIO_SMTP_TIMEOUT=10
FACESTUDIO_SMTP_TOTAL_TIMEOUT=9
    