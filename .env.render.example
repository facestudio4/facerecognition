APP_ENV=production
APP_NAME=FaceRecognitionStudio
API_HOST=0.0.0.0
API_PORT=8787
SQLITE_PATH=/var/data/facestudio.db
# Store enrolled face images + encodings on the persistent disk so they survive
# redeploys/restarts (Render's filesystem is otherwise ephemeral).
FACES_ROOT=/var/data/faces
FACE_ENCODINGS_PATH=/var/data/face_encodings.pkl

FACE_STUDIO_MOBILE_LATEST_VERSION=0.1.0+33
FACE_STUDIO_MOBILE_MIN_VERSION=0.1.0+33
FACE_STUDIO_MOBILE_APK_URL=https://github.com/facestudio4/facerecognition/releases/download/v0.1.0%2B33/mobile_0.1.0%2B33.apk
FACE_STUDIO_MOBILE_UPDATE_NOTES=Face Studio mobile v0.1.0+33 improves recognition reliability, smoother card visuals, and behind-the-scenes performance and stability fixes.
FACE_STUDIO_MOBILE_FORCE_UPDATE=false

MOBILE_RECOGNITION_THRESHOLD=0.48
MOBILE_RECOGNITION_MARGIN=0.03

FACESTUDIO_SIGNUP_ALLOW_SMTP_FALLBACK=1

# IMPORTANT: Render blocks outbound SMTP (you'll see "Network is unreachable").
# Send verification emails over an HTTP API instead. Brevo is free (300/day) and
# needs no domain — just verify the sender (FACESTUDIO_SMTP_FROM) in Brevo, then
# create an API key and put it here. When set, this is used instead of SMTP.
FACESTUDIO_BREVO_API_KEY=your-brevo-api-key
FACESTUDIO_EMAIL_FROM_NAME=Face Studio

# SMTP is only a local-dev fallback (does not work on Render).
FACESTUDIO_SMTP_HOST=smtp.gmail.com
FACESTUDIO_SMTP_USER=your-email@gmail.com
FACESTUDIO_SMTP_APP_PASSWORD=your-app-password
FACESTUDIO_SMTP_FROM=your-email@gmail.com
FACESTUDIO_SMTP_PORT=587
FACESTUDIO_SMTP_TLS=1
FACESTUDIO_SMTP_SSL=0
FACESTUDIO_SMTP_TIMEOUT=10
FACESTUDIO_SMTP_TOTAL_TIMEOUT=9
    